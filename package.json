{
  "name": "vaartix-mcp",
  "version": "0.3.0",
  "description": "MCP server for Vaartix: let Claude, Cursor and other AI tools send and track transactional email",
  "license": "MIT",
  "type": "module",
  "homepage": "https://vaartix.com/docs/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vaartix-mail/vaartix-mcp.git"
  },
  "bugs": {
    "url": "https://github.com/vaartix-mail/vaartix-mcp/issues"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "email",
    "transactional-email",
    "vaartix",
    "claude",
    "cursor",
    "india"
  ],
  "engines": {
    "node": ">=20"
  },
  "bin": {
    "vaartix-mcp": "dist/index.js"
  },
  "exports": {
    "./tools": {
      "types": "./dist/tools.d.ts",
      "default": "./dist/tools.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "format": "biome format --write .",
    "test": "vitest run",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "^2.4.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.3",
    "@modelcontextprotocol/client": "^2.4.0",
    "@types/node": "^26.6.5",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
